# Prebuilt app image published by .github/workflows/docker.yml to GHCR.
# Example: ghcr.io/yourname/waha-single:latest  (make the package PUBLIC
# under GitHub > profile > Packages, or deploy.sh will fail to pull)
APP_IMAGE=ghcr.io/yourname/waha-single:latest

# Copy to .env and fill in (deploy.sh generates this automatically)
WAHA_API_KEY=change-me-to-32-hex-chars
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=change-me
WAHA_DASHBOARD_ENABLED=True
WHATSAPP_SWAGGER_ENABLED=True

# Single session name (do not change after first start)
SINGLE_SESSION=default

# Host ports (bound to loopback only)
WAHA_PORT=3000
APP_PORT=4000

# Local dev only (compose overrides WAHA_URL to http://waha:3000).
# For `node server.js` without docker: WAHA_URL=http://localhost:3000
WAHA_URL=http://localhost:3000
PORT=3102
